# Allow only this site's own scripts and connections.
# Pages can still add an analytics tag during deployment; CSP blocks execution.
/*
  Content-Security-Policy: script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'

# Only Vite's content-hashed files are immutable. HTML and screenshot filenames
# stay on Pages' default revalidation policy so later content updates arrive.
/assets/*
  Cache-Control: public, max-age=31536000, immutable, no-transform

/fonts/*
  Cache-Control: public, max-age=86400, no-transform
